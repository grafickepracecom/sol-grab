# Import rozvrhu ze Skoly OnLine do SQLite pro signage.
# NASAZENA verze je v /etc/cron.d/sol-grab (tohle je jen kopie sablony v repu).
#
#   sudo cp bin/crontab.priklad /etc/cron.d/sol-grab
#   sudo chown root:root /etc/cron.d/sol-grab && sudo chmod 644 /etc/cron.d/sol-grab
#
# Soubor v /etc/cron.d/ musi vlastnit root a nesmi mit tecku v nazvu.
# Bezi pod uzivatelem sol, ktery vlastni projekt i databazi.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Kazdy den vcetne vikendu: zmeny se delaji i odpoledne/vecer, rano ma byt cerstvo.
# KRO029 vraci vsechny tridy jednim GETem, takze je to lehke i pri caste synchronizaci.
*/15 5-22 * * *  sol  /usr/bin/python3 /var/www/sol-grab/bin/import_sol.py --tise >> /var/log/sol-grab.log 2>&1
0 23,0-4 * * *   sol  /usr/bin/python3 /var/www/sol-grab/bin/import_sol.py --tise >> /var/log/sol-grab.log 2>&1

# Log: sudo touch /var/log/sol-grab.log && sudo chown sol:adm /var/log/sol-grab.log && sudo chmod 640 /var/log/sol-grab.log
