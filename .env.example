# Zkopírujte na .env a doplňte skutečné hodnoty. Soubor .env je v .gitignore.
SOL_USERNAME=jmeno.prijmeni
SOL_PASSWORD=heslo

# Volitelné — výchozí hodnoty stačí pro instalaci na aplikace.skolaonline.cz
SOL_BASE_URL=https://aplikace.skolaonline.cz/solapi
SOL_WEB_URL=https://aplikace.skolaonline.cz
SOL_CLIENT_ID=test_client

# Na kterém portu poslouchá webový náhled
SOL_WEB_PORT=8081

# Časové okno signage obrazovky v minutách (zpět a vpřed od aktuální chvíle)
SOL_OKNO_ZPET=60
SOL_OKNO_VPRED=120

# Jak často se obrazovka sama překreslí (s)
SOL_OBNOVA=60
